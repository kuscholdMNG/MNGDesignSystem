{
  "$description": "MNG Device breakpoints (core). Min-width boundaries matching the Figma screen widths. Below breakpoint.mobile (360) is Fold, designed at 340. Reader Dashboard today; every product eventually. Production drift: production-vs-design-differences.md entry 30.",
  "breakpoint": {
    "$type": "dimension",
    "mobile": {
      "$value": {
        "value": 360,
        "unit": "px"
      },
      "$description": "Mobile, 360px and up. Below this is Fold (Figma frame 340).",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 360
          }
        }
      }
    },
    "tablet": {
      "$value": {
        "value": 768,
        "unit": "px"
      },
      "$description": "Tablet (vertical), 768px and up.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 768
          }
        }
      }
    },
    "tablet-landscape": {
      "$value": {
        "value": 1024,
        "unit": "px"
      },
      "$description": "Tablet horizontal, 1024px and up. Reader Dashboard's layout switches here.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 1024
          }
        }
      }
    },
    "desktop": {
      "$value": {
        "value": 1280,
        "unit": "px"
      },
      "$description": "Desktop, 1280px and up.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 1280
          }
        }
      }
    }
  }
}
