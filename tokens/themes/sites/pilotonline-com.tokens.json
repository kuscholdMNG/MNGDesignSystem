{
  "$description": "The Virginian-Pilot (pilotonline.com) site overrides on top of Measured Vibrant. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "The Virginian-Pilot",
      "domain": "pilotonline.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 1,
          "hex": "#000000"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(0, 0, 0, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      },
      "subsite-text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9765,
            0.9765,
            0.9765
          ],
          "alpha": 1,
          "hex": "#f9f9f9"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(249, 249, 249, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
