{
  "$description": "Chicago Tribune (chicagotribune.com) site overrides on top of Chicago Tribune. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "Chicago Tribune",
      "domain": "chicagotribune.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9922,
            0.9922,
            0.9922
          ],
          "alpha": 1,
          "hex": "#fdfdfd"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(253, 253, 253, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      },
      "subsite-text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0392,
            0.0392
          ],
          "alpha": 1,
          "hex": "#0a0a0a"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(10, 10, 10, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
