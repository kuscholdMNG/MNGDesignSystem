{
  "$description": "Trentonian (trentonian.com) site overrides on top of Modern Earthy. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "Trentonian",
      "domain": "trentonian.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0471,
            0.5608,
            0.8118
          ],
          "alpha": 1,
          "hex": "#0c8fcf"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(12, 143, 207, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      },
      "subsite-text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9765,
            0.9765,
            0.9765
          ],
          "alpha": 1,
          "hex": "#f9f9f9"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(249, 249, 249, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
