{
  "$description": "Reading Eagle (readingeagle.com) site overrides on top of Modern Earthy. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "Reading Eagle",
      "domain": "readingeagle.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9804,
            0.9804,
            0.9804
          ],
          "alpha": 1,
          "hex": "#fafafa"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(250, 250, 250, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      },
      "subsite-text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 1,
          "hex": "#000000"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(0, 0, 0, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
