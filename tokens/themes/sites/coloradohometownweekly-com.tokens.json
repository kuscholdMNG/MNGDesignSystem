{
  "$description": "Colorado Hometown Weekly (coloradohometownweekly.com) site overrides on top of NEPA-PMP. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "Colorado Hometown Weekly",
      "domain": "coloradohometownweekly.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0.3294,
            0.6275
          ],
          "alpha": 1,
          "hex": "#0054a0"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(0, 84, 160, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
